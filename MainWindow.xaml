<Window x:Class="PrintSpooler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rudraksh Print Spooler" Height="550" Width="850" 
        Background="#f0f2f5" Foreground="#1a1a1a"
        WindowStartupLocation="CenterScreen" Icon="App.xaml">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#022c22" Padding="20,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Rudraksh Print Spooler" FontSize="24" FontWeight="Bold" Foreground="#d4af37" VerticalAlignment="Center"/>
                <TextBlock Text="v2.0" FontSize="12" Foreground="#d4af37" Opacity="0.7" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
            </StackPanel>
        </Border>

        <!-- Main Content (Tabs) -->
        <TabControl Grid.Row="1" Margin="15" BorderThickness="0" Background="Transparent">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold" Padding="15,8"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Setup Tab -->
            <TabItem Header="Setup">
                <Grid Background="White" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Margin="30">
                        <TextBlock Text="Connection &amp; Printer" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
                        
                        <TextBlock Text="API Endpoint URL (GET):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="ApiUrlBox" Margin="0,0,0,20" Padding="8" BorderBrush="#cbd5e1" Background="#f8fafc"/>

                        <TextBlock Text="Select Printer:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="PrinterComboBox" Margin="0,0,0,25" Padding="8"/>

                        <Separator Margin="0,0,0,20"/>

                        <TextBlock Text="Settings" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                        <CheckBox x:Name="AutoStartCheckBox" Content="Launch automatically when Windows starts" Margin="0,0,0,10" FontSize="14" Click="AutoStartCheckBox_Click"/>
                        <CheckBox x:Name="MinimizeToTrayCheckBox" Content="Minimize to system tray when closed" IsChecked="True" Margin="0,0,0,20" FontSize="14"/>

                        <Button x:Name="PollButton" Content="Start Background Polling" Background="#022c22" Foreground="#d4af37" 
                                Padding="20,12" FontSize="16" FontWeight="Bold" Click="PollButton_Click" HorizontalAlignment="Left" MinWidth="250"/>
                    </StackPanel>

                    <Border Grid.Column="1" Width="200" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1,0,0,0" Padding="15">
                        <StackPanel>
                            <TextBlock Text="System Info" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="OS: Windows" Foreground="Gray"/>
                            <TextBlock x:Name="SessionTimeLabel" Text="Uptime: 00:00:00" Foreground="Gray" Margin="0,5,0,0"/>
                            <TextBlock x:Name="JobsCountLabel" Text="Jobs today: 0" Foreground="Gray" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Activity Log Tab -->
            <TabItem Header="Activity Log">
                <Grid Background="White" Margin="0,5,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="LogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                             Background="#f8fafc" BorderThickness="0" Padding="15" 
                             TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                        <Button Content="Clear Log" Click="ClearLog_Click" Padding="15,5"/>
                        <Button Content="Open Log Folder" Click="OpenLogFolder_Click" Padding="15,5"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Diagnostics / Preview Tab -->
            <TabItem Header="Diagnostics">
                <Grid Background="White" Margin="0,5,0,0">
                    <StackPanel Margin="30">
                        <TextBlock Text="Last Print Job Preview" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock Text="Raw TSPL/ZPL data received from the API for the most recent job." Foreground="Gray" Margin="0,0,0,15"/>
                        
                        <TextBox x:Name="PreviewBox" Height="250" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                                 Background="#f8fafc" BorderBrush="#cbd5e1" Padding="10" 
                                 TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Margin="0,0,0,10"/>
                        
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Copy Print Script" Click="CopyScript_Click" Padding="20,8" FontWeight="Bold"/>
                            <Button Content="Simulate Print" Click="SimulatePrint_Click" Padding="20,8" Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#e2e8f0" Padding="10,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusLog" Text="Status: Initializing..." FontSize="11"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ClockText" Text="00:00:00" FontSize="11" Foreground="Gray"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
